---
/**
 * Nav mark: the triangle emblem from the client's logo (versionB_blacktranparent.png, texted 2026-10-19),
 * traced to SVG with potrace (docs/brand/). Served as an <img> rather than inlined: the traced paths are ~150 KB.
 * Full logo with wordmark: src/assets/brand/logo-black.svg / logo-white.svg.
 */
import mark from '../assets/brand/mark-black.svg';
---
<img src={mark.src} alt="" width="32" height="28" decoding="async" aria-hidden="true" />
