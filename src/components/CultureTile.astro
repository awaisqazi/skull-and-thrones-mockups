---
/**
 * One /culture/ collage tile. Reuses the portfolio .tile styles + filter/lightbox scripts:
 * data-tags drives the filter chips; only tiles with a real photo get the zoom button (lightbox,
 * which shows data-caption). No outbound Instagram link on a tile (client 2026-10-18).
 * Photo source order: remote `image` URL > src/assets/culture/<image or id> > placeholder.
 */
import { Image, getImage } from 'astro:assets';
import { localCultureImage } from '../lib/localImages';
import type { CultureItem } from '../lib/data';

interface Props { item: CultureItem; size?: 'big' | 'wide' | 'tall' | 'std' }
const { item: t, size = 'std' } = Astro.props;
const local = (t.image && !t.remote ? localCultureImage(t.image) : undefined) ?? localCultureImage(t.id);
const hasPhoto = Boolean(local || t.remote);
const alt = hasPhoto ? t.caption : `Placeholder photo: ${t.caption}`;
// Lightbox copy: 1200 px WebP (QA P2-12; was a 1600 px JPEG).
const full = local ? (await getImage({ src: local, width: 1200, format: 'webp', quality: 78 })).src : (t.remote ?? undefined);
const big = size !== 'std'; // tall tiles are 2 cells high, so a cover-cropped photo renders ~2 cells wide too
const imgWidth = 800; // QA R-02: collage thumbs capped at 800w; the 1200w copy is only for the lightbox
const imgSizes = big ? '(min-width: 1100px) 48vw, (min-width: 700px) 64vw, 100vw' : '(min-width: 1100px) 24vw, (min-width: 700px) 32vw, 48vw';
---
<figure class:list={['tile', 'collage__item', `collage__item--${size}`]} data-tags={t.category} data-full={full} data-caption={t.caption}>
  {local
    ? <Image src={local} alt={alt} width={imgWidth} widths={[400, 600, 800]} sizes={imgSizes} quality={70} fit="cover" position="attention" loading="lazy" />
    : t.remote
      ? <img src={t.remote} alt={alt} loading="lazy" />
      : <img src={t.placeholder_src} alt={alt} width="800" height="800" loading="lazy" />}
  {hasPhoto && <button class="tile__zoom" type="button" aria-label={`Enlarge: ${t.caption}`}></button>}
  {/* Client 2026-10-18: photo + caption only, no Instagram link-out. source_url/credit stay in the data (rights trail). */}
  {!hasPhoto && <span class="ph-tag">Photo coming</span>}
  <figcaption class="tile__overlay">
    <span class="collage__meta">{t.category}{t.date_label && <> · <time datetime={t.date}>{t.date_label}</time></>}</span>
    <span class="tile__cap">{t.caption}</span>
  </figcaption>
</figure>
