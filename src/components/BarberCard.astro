---
import { Image } from 'astro:assets';
import type { Barber } from '../lib/data';
import { headshotFor } from '../lib/localImages';
import { barberView, parseFile, NEW_CLIENTS } from '../lib/availability';
// Baked snapshot (deploy.yml copies the `data` branch file here before the build; checked-in default = empty).
import bakedJson from '../data/availability.json';

interface Props {
  barber: Barber;
  locationName: string;
  headingLevel?: 'h2' | 'h3';
  /** Above the fold (first row of the first visible grid): load the headshot eagerly. */
  eager?: boolean;
}
const { barber: b, locationName, headingLevel: H = 'h3', eager = false } = Astro.props;
// Square photo (headshot_source 'square') → local file → other remote headshot → placeholder (headshotFor, spec §4).
// A Square URL is downloaded and optimised at build like a local file (astro.config.mjs image.remotePatterns).
// The template has two <Image> branches only for the types (astro:assets types a remote URL and a local import
// separately); both render the same markup.
const photo = headshotFor(b);
const hasPhoto = Boolean(photo);
const alt = hasPhoto ? `Headshot of ${b.name}` : `Placeholder headshot for ${b.name}`;
const flag = b.accepting_new_clients ? NEW_CLIENTS.yes : NEW_CLIENTS.no;
// Live Square availability (spec §3). null = no data: the chip renders hidden and
// src/scripts/availability.ts fills it in from the live file when there is one.
const avail = barberView(parseFile(bakedJson), b.location, b.item_id, new Date());
const img = { widths: [300, 450, 600], sizes: '(min-width: 1100px) 22vw, (min-width: 700px) 30vw, 46vw', loading: eager ? 'eager' as const : 'lazy' as const, fetchpriority: eager ? 'high' as const : undefined };
---
<article class="card" data-slug={b.slug} data-loc={b.location} data-needs-profile={b.needs_profile ? '' : undefined}>
  <div class:list={['card__media', !hasPhoto && 'card__media--initials']} data-initials={b.initials}>
    {typeof photo === 'string'
      ? <Image src={photo} alt={alt} width={600} height={750} {...img} />
      : photo
        ? <Image src={photo} alt={alt} width={600} height={750} {...img} />
        : <span class="sr-only">Photo of {b.name} coming soon</span>}
    <div class="card__flags">
      <span class="avail" data-avail={b.item_id} data-shop={b.location} data-state={avail?.state} hidden={!avail}>
        <i class="avail__dot" aria-hidden="true"></i><span class="avail__text">{avail?.next
          ? <><span class="avail__pre">Next: </span><time datetime={avail.next.iso}>{avail.next.label}</time></>
          : avail?.text}</span>
      </span>
      <span class:list={['newclients', !b.accepting_new_clients && 'newclients--off']} title={flag.tip}>{flag.label}</span>
    </div>
  </div>
  <div class="card__body">
    <H class="card__name"><a class="card__open" href={b.href}>{b.name}</a></H>
    <p class="card__role">{b.role}</p>
    {b.haircut_from != null && <p class="card__price">Haircuts from <b>${b.haircut_from}</b></p>}
    {b.specialties.length > 0 && (
      <ul class="chips" aria-label="Specialties">{b.specialties.map((s) => <li class="chip">{s}</li>)}{b.specialties.length > 2 && <li class="chip chip--more" aria-hidden="true">+{b.specialties.length - 2}</li>}</ul>
    )}
    <div class="card__foot">
      <a class="btn btn--sm card__book" href={b.booking_url} target="_blank" rel="noopener" aria-label={`Book with ${b.name} at ${locationName} (opens Square)`}>Book <span class="arr" aria-hidden="true">↗</span></a>
      <span class="card__more" aria-hidden="true">Profile +</span>
    </div>
  </div>
</article>
