---
import { Image } from 'astro:assets';
import type { Barber } from '../lib/data';

interface Props { barber: Barber; locationName: string; headingLevel?: 'h2' | 'h3' }
const { barber: b, locationName, headingLevel: H = 'h3' } = Astro.props;
const alt = b.headshot ? `Headshot of ${b.name}` : `Placeholder headshot for ${b.name}`;
---
<article class="card" data-slug={b.slug} data-loc={b.location}>
  <div class="card__media" data-initials={b.initials}>
    {b.headshot
      ? <Image src={b.headshot} alt={alt} width={600} height={750} loading="lazy" />
      : <img src={b.headshot_src} alt={alt} width="600" height="750" loading="lazy" />}
    {b.accepting_new_clients && <span class="accepting"><i class="dot" aria-hidden="true"></i><span>Taking new clients</span></span>}
    {!b.headshot && <span class="ph-tag">Placeholder</span>}
  </div>
  <div class="card__body">
    <H class="card__name"><a class="card__open" href={b.href}>{b.name}</a></H>
    <p class="card__role">{b.role}</p>
    <p class="card__price">Haircuts from <b>${b.haircut_from}</b></p>
    {b.specialties.length > 0 && (
      <ul class="chips" aria-label="Specialties">{b.specialties.map((s) => <li class="chip">{s}</li>)}</ul>
    )}
    <div class="card__foot">
      <a class="btn btn--sm card__book" href={b.booking_url} target="_blank" rel="noopener" aria-label={`Book with ${b.name} at ${locationName} (opens Square)`}>Book <span class="arr" aria-hidden="true">↗</span></a>
      <span class="card__more" aria-hidden="true">Profile +</span>
    </div>
  </div>
</article>
