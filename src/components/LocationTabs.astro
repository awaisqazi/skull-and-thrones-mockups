---
/**
 * Location tablist that drives a <BarberGrid prefix=…> (WAI-ARIA tabs; #addison / #elmhurst in the URL).
 *
 * `neutral` (home page only): no shop is pre-selected. Every tab renders aria-selected="false"
 * until the visitor picks one (here or in the "Choose your shop" prompt BarberGrid renders).
 * APG tabs assume one selected tab, but a tablist with nothing selected yet is valid ARIA:
 * aria-selected="false" on all tabs simply says "no panel is showing", which is true while the
 * prompt is up; the first tab stays in the Tab order (tabindex 0) so keyboard users can reach it.
 * app.ts restores #hash > ?location= > localStorage "st-location" before falling back to neutral.
 */
import { getLocations, getBarbers } from '../lib/data';
interface Props { prefix: string; size?: 'lg'; neutral?: boolean }
const { prefix, size, neutral = false } = Astro.props;
const locations = await getLocations();
const barbers = await getBarbers();
---
<div class:list={['tabs', size === 'lg' && 'tabs--lg']} role="tablist" aria-label="Choose a location" data-sync="loc" data-hash data-neutral={neutral ? '' : undefined} data-chooser={neutral ? `${prefix}-chooser` : undefined}>
  {locations.map((l, i) => (
    <button class="tab" type="button" role="tab" id={`${prefix}-tab-${l.slug}`} data-key={l.slug} aria-controls={`${prefix}-${l.slug}`} aria-selected={!neutral && i === 0 ? 'true' : 'false'}>
      {l.name} <span class="tab__count">{barbers.filter((b) => b.location === l.slug).length}</span>
    </button>
  ))}
</div>
