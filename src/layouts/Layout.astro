---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileBookBar from '../components/MobileBookBar.astro';
import Lightbox from '../components/Lightbox.astro';
import { getImage } from 'astro:assets';
import ogSource from '../assets/og.png';
import antonWoff2 from '../assets/fonts/anton-400-latin.woff2?url';
import interTightWoff2 from '../assets/fonts/inter-tight-latin-var.woff2?url';
import { getLocations, getHoursPayload } from '../lib/data';
import { SITE } from '../lib/site';
import { url } from '../lib/url';
import { DEFAULT_LIVE_URL, parseFile, slimFile } from '../lib/availability';
import { jsonForScript } from '../lib/safe';
import { buildJsonLd } from '../lib/schema';
import { localLocationPhoto } from '../lib/localImages';
import bakedAvailability from '../data/availability.json';

export type NavKey = 'home' | 'team' | 'portfolio' | 'culture' | 'shop' | 'book' | 'contact' | 'none';

interface Props {
  title: string;
  description: string;
  /** Primary-nav item to mark aria-current */
  current?: NavKey;
  /** Initial body[data-loc] (location-scoped content). Omitted = neutral (home: no shop favoured until the visitor picks). */
  loc?: 'addison' | 'elmhurst';
  page?: string;
  noindex?: boolean;
  ogType?: 'website' | 'profile';
}

const { title, description, current = 'none', loc, page = 'page', noindex = false, ogType = 'website' } = Astro.props;
const fullTitle = title.includes('Skull & Thrones') ? title : `${title} · ${SITE.name}`;
const site = Astro.site ?? new URL('https://awaisqazi.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const og = await getImage({ src: ogSource, width: 1200, height: 630, format: 'png' });
const ogImage = new URL(og.src, site).href;

const locations = await getLocations();
// Structured data lives in src/lib/schema.ts (unit-tested); this only supplies the absolute URLs.
const abs = (path: string) => new URL(path, site).href;
const locationPhotos = Object.fromEntries(
  await Promise.all(locations.map(async (l) => {
    const src = localLocationPhoto(l.slug);
    return [l.slug, src ? abs((await getImage({ src, width: 1200 })).src) : undefined] as const;
  })),
);
const jsonLd = buildJsonLd(locations, {
  site: SITE,
  abs,
  orgId: abs(url('#organization')),
  homeUrl: abs(url('')),
  locationId: (slug) => abs(url(`${slug}/#salon`)),
  logo: abs(url('logo-512.png')),
  fallbackImage: ogImage,
  locationImage: (slug) => locationPhotos[slug],
});
const hours = await getHoursPayload();
// Live availability chips (spec §3) render on these pages only (barber cards, barber page, /book).
// They get the baked snapshot plus the live file's URL; src/scripts/availability.ts swaps in newer data.
const AVAILABILITY_PAGES = new Set(['home', 'location', 'team', 'barber', 'book']);
const availability = AVAILABILITY_PAGES.has(page)
  ? { src: import.meta.env.PUBLIC_AVAILABILITY_URL || DEFAULT_LIVE_URL, file: slimFile(parseFile(bakedAvailability)) }
  : null;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{fullTitle}</title>
<meta name="description" content={description}>
{!noindex && <link rel="canonical" href={canonical}>}
{noindex && <meta name="robots" content="noindex, follow">}
<meta name="theme-color" content="#EAEAEA">
<meta name="color-scheme" content="light">
<link rel="icon" href={url('favicon-32.png')} type="image/png" sizes="32x32">
<link rel="icon" href={url('favicon-192.png')} type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href={url('apple-touch-icon.png')}>
<link rel="sitemap" href={url('sitemap-index.xml')}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
{/* Self-hosted fonts (src/assets/fonts/, latin subset; @font-face + metric-matched fallbacks in global.css section 23). Both are used above the fold on every page. */}
<link rel="preload" href={antonWoff2} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={interTightWoff2} as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" set:html={jsonForScript(jsonLd)} />
<script type="application/json" id="st-hours" set:html={jsonForScript(hours)} />
<slot name="head" />
</head>
<body data-loc={loc} data-page={page}>
<a class="skip" href="#main">Skip to content</a>
<Nav current={current} />
<main id="main">
  <slot />
</main>
<Footer />
<MobileBookBar />
<Lightbox />
{/* One script on every page. app.ts loads src/scripts/availability.ts itself when #st-avail is present: a second,
    conditional <script> here made Astro serve the availability bundle INSTEAD of app.ts on pages without chips
    (contact, shop, culture, 404), which left the menu, popovers and "Open now" dead there (QA 2026-10-28). */}
<script>
  import '../scripts/app.ts';
</script>
{availability && <script type="application/json" id="st-avail" set:html={jsonForScript(availability)} />}
</body>
</html>
