---
/* /portfolio → /addison/#portfolio (per docs/SITEMAP.md). Static host, so meta refresh + link. */
import { url } from '../lib/url';
const target = url('addison/#portfolio');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Portfolio · Skull &amp; Thrones</title>
<meta name="robots" content="noindex">
<link rel="canonical" href={new URL(url('addison/'), Astro.site).href}>
<meta http-equiv="refresh" content={`0; url=${target}`}>
</head>
<body><p><a href={target}>See the portfolio</a></p></body>
</html>
