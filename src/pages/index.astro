---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import LocationTabs from '../components/LocationTabs.astro';
import BarberGrid from '../components/BarberGrid.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import LocationCard from '../components/LocationCard.astro';
import ProductStrip from '../components/ProductStrip.astro';
import { getLocations, getBarbers, getPortfolio } from '../lib/data';
import { placeholder } from '../lib/placeholder';
import { SITE } from '../lib/site';
import { url } from '../lib/url';

const locations = await getLocations();
const barbers = await getBarbers();
const [first, second] = locations;
const featured = await Promise.all(locations.map(async (l) => ({ l, items: await getPortfolio({ location: l.slug, featured: true }) })));
// Neutral home (no shop picked yet): one strip that alternates both floors, so neither shop is favoured (QA P2-05).
const mixed = Array.from({ length: Math.max(0, ...featured.map((f) => f.items.length)) }, (_, i) => featured.map((f) => f.items[i]))
  .flat().filter((t): t is NonNullable<typeof t> => Boolean(t)).slice(0, 6);
const marquee = ['Skin fades', 'Scissor work', 'Beards', 'Kids cuts', 'Long hair', 'Color', 'Designs', 'Hot towel'];
// Recent posts: src/data/instagram.json + matching src/assets/instagram/<id>.jpg (manual refresh for now; feed sync is a phase-2 item).
// Client 2026-10-18: tiles are photo + caption and open the shared lightbox; they never link out to the post
// (the `url` field stays in the data as the rights trail). Only the "Follow" button links to the profile.
import igPosts from '../data/instagram.json';
const igFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/instagram/*.{jpg,jpeg,png,webp}', { eager: true });
const igImage = (id: string) => Object.entries(igFiles).find(([k]) => k.endsWith(`/${id}.jpg`) || k.endsWith(`/${id}.png`) || k.endsWith(`/${id}.webp`))?.[1].default;
const igTiles: { id: string; caption: string; image?: ImageMetadata; full?: string }[] = await Promise.all(
  igPosts.slice(0, 6).map(async (p) => {
    const image = igImage(p.id);
    // Lightbox copy: 1200 px WebP, same as portfolio/culture tiles.
    const full = image ? (await getImage({ src: image, width: Math.min(1200, image.width), format: 'webp', quality: 78 })).src : undefined;
    return { id: p.id, caption: p.caption, image, full };
  }),
);
while (igTiles.length < 6) igTiles.push({ id: `ph-${igTiles.length}`, caption: 'Instagram post (placeholder)' });
// Drop a photo at src/assets/hero.(jpg|png|webp) to replace the hero placeholder.
const heroFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/hero.{jpg,jpeg,png,webp}', { eager: true });
const hero = Object.values(heroFiles)[0]?.default;
---
<Layout
  title="Barbershop in Addison & Elmhurst, IL · Skull & Thrones"
  description={`Skull & Thrones (S&T Hair Society): ${barbers.length} barbers across Addison and Elmhurst, IL. Find your barber, see their work, book online.`}
  current="home"
  page="home"
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="rule-row"><span class="eyebrow">S&amp;T Hair Society</span><span class="eyebrow">Addison · Elmhurst, IL</span></div>
    <h1 class="giant hero__word" id="hero-title"><span>Skull &amp;</span>{' '}<span>Thrones</span></h1>
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="hero__tag">Progress through<br />creativity.</p>
        <p class="lead muted">Two shops, {barbers.length} barbers, every one with their own style. Find your barber, see their work, and book in under a minute.</p>
        <div class="btn-row">
          {first && <a class="btn btn--lg" href={first.square_booking_url} target="_blank" rel="noopener"><span class="dot" aria-hidden="true"></span>Book {first.name}</a>}
          {second && <a class="btn btn--light btn--lg" href={second.square_booking_url} target="_blank" rel="noopener">Book {second.name} <span class="arr" aria-hidden="true">↗</span></a>}
        </div>
        {SITE.rating.verified && <p class="rating"><span class="rating__stars" aria-hidden="true">★★★★★</span><span><b>{SITE.rating.value}</b> on Google · {SITE.rating.count} reviews</span></p>}
        <ul class="hero__status" aria-label="Shop status">
          {locations.map((l) => <li>{l.name} <span class="status" data-open-status={l.slug} role="status">{l.hours_short}</span></li>)}
        </ul>
      </div>
      <div class="media hero__media">
        {hero
          ? <Image src={hero} alt="A Skull & Thrones barber shaping a fade with clippers" width={1600} height={1100} widths={[600, 1200, 1600]} sizes="(min-width: 900px) 58vw, 100vw" fit="cover" position="attention" fetchpriority="high" loading="eager" />
          : <img src={placeholder(1600, 1100, 'Hero shop')} alt="Placeholder: interior of the shop" width="1600" height="1100" fetchpriority="high" />}
        {!hero && <span class="ph-tag">Placeholder photo</span>}
        <a class="badge" href={url('book/')} aria-label="Book now: pick your chair">
          <svg viewBox="0 0 100 100" aria-hidden="true"><defs><path id="ring" d="M50 50m-38 0a38 38 0 1 1 76 0a38 38 0 1 1-76 0" /></defs><text font-family="Inter Tight, sans-serif" font-size="9" font-weight="700" fill="#111"><textPath href="#ring" textLength="236" lengthAdjust="spacing">BOOK NOW · PICK YOUR CHAIR · </textPath></text></svg>
          <b aria-hidden="true">S&amp;T</b>
        </a>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true"><div class="marquee__track"><div>{marquee.map((w) => <span>{w}</span>)}</div><div class="marquee__dup">{marquee.map((w) => <span>{w}</span>)}</div></div></div>

  <section class="section wrap" id="barbers" aria-labelledby="barbers-title">
    <div class="sec-head">
      <span class="sec-num">01 — Team</span>
      <div><h2 class="h2" id="barbers-title">Pick your chair.</h2><p>Every barber, both shops. Tap a card for their bio and work, or hit Book to go straight to Square.</p></div>
      <LocationTabs prefix="home" neutral />
    </div>
    <BarberGrid prefix="home" neutral />
  </section>

  <section class="section--tight wrap" aria-labelledby="work-title">
    <div class="sec-head">
      <span class="sec-num">02 — Work</span>
      <div><h2 class="h2" id="work-title">Fresh off the chair.</h2><p>Recent cuts from <span data-loc-text="the {Loc} floor">both floors</span>. Every photo links to the barber who did it.</p></div>
      <a class="link" data-loc-only="chosen" href={url(`${first?.slug}/#portfolio`)} data-loc-href={url('{loc}/#portfolio')}><span data-loc-text="See all {Loc} work">See all {first?.name} work</span> <span class="arr" aria-hidden="true">→</span></a>
      <span class="work-links" data-loc-only="neutral">{locations.map((l) => <a class="link" href={url(`${l.slug}/#portfolio`)}>{l.name} work <span class="arr" aria-hidden="true">→</span></a>)}</span>
    </div>
    <div data-loc-only="neutral"><PortfolioGrid id="work-both" items={mixed} layout="strip" /></div>
    {featured.map(({ l, items }) => (
      <div data-loc-only={l.slug}><PortfolioGrid id={`work-${l.slug}`} items={items} layout="strip" /></div>
    ))}
  </section>

  <ProductStrip />

  <section class="section wrap" id="locations" aria-labelledby="loc-title">
    <div class="sec-head">
      <span class="sec-num">03 — Visit</span>
      <div><h2 class="h2" id="loc-title">Two shops. Same standard.</h2></div>
      <a class="link" href={url('contact/')}>Maps &amp; hours <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <div class="loc-grid">
      {locations.map((l, i) => <LocationCard location={l} ink={i === 0} />)}
    </div>
  </section>

  <section class="section--tight wrap" aria-labelledby="ig-title">
    <div class="sec-head">
      <span class="sec-num">04 — Social</span>
      <div><h2 class="h2" id="ig-title">@{SITE.instagram_handle}</h2><p>Daily cuts, transformations and shop life.</p></div>
      <a class="btn btn--light" href={SITE.instagram} target="_blank" rel="noopener">Follow <span class="arr" aria-hidden="true">↗</span></a>
    </div>
    <div class="ig">
      {igTiles.map((p, i) => (
        <figure class="tile ig__item" data-full={p.full} data-caption={p.image ? p.caption : undefined}>
          {p.image
            ? <Image src={p.image} alt={p.caption} width={500} height={500} fit="cover" position="attention" loading="lazy" />
            : <img src={placeholder(500, 500, `IG ${i}`)} alt="" width="500" height="500" loading="lazy" />}
          {p.image
            ? <button class="tile__zoom" type="button" aria-label={`Enlarge: ${p.caption}`}></button>
            : <span class="ph-tag">Placeholder</span>}
        </figure>
      ))}
    </div>
  </section>
</Layout>
