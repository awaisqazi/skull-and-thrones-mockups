---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts, getLocations, productVendors, productsFromSquare } from '../lib/data';

const products = await getProducts();
const vendors = productVendors(products);
const locations = await getLocations();
// QA P2-09: render the first FIRST cards; the rest wait in a <template> (inert: no DOM, no image requests)
// until "Show all" or any brand filter is pressed (src/scripts/app.ts [data-more]).
// SHOP_SOURCE=square: a small in-shop catalog, so no deferral (and no Bodega "see all" fallback).
const fromSquare = productsFromSquare(products);
const FIRST = fromSquare ? products.length : 24;
const shown = products.slice(0, FIRST);
const later = products.slice(FIRST);
// Cards are 2/3/4 per row and the packshot sits at 80 % of the card width.
const sizes = '(min-width: 1100px) 270px, (min-width: 700px) 25vw, 38vw';
---
<Layout
  title="Shop"
  description={fromSquare
    ? 'Shop STMNT, H14 and Slick Gorilla, the three lines the Skull & Thrones barbers stock and use. Buy online or pick them up at our shops.'
    : 'Shop STMNT, H14 and Slick Gorilla, the three lines the Skull & Thrones barbers stock and use. Orders ship from Bodega; the same products are stocked at both shops.'}
  current="shop"
  page="shop"
>
  <section class="page-hero wrap" aria-labelledby="shop-title">
    <div class="rule-row"><span class="eyebrow">{products.length} products · {vendors.length} brands</span><span class="eyebrow">{fromSquare ? 'Stocked at our shops' : 'Sold by Bodega'}</span></div>
    <h1 class="giant" id="shop-title">Shop</h1>
    <div class="page-hero__row">
      {fromSquare
        ? <p class="lead">STMNT, H14 and Slick Gorilla: the three lines we stock and use in the chair. Order online or grab them at your next cut. Clippers, shears and everything else live at Bodega.</p>
        : <p class="lead">STMNT, H14 and Slick Gorilla: the three lines we stock and use in the chair. Orders ship from Bodega, and the same products are on the shelf at both shops if you'd rather grab them at your next cut. Clippers, shears and everything else live on bybodega.com.</p>}
      <a class="link" href="https://www.bybodega.com/" target="_blank" rel="noopener">{fromSquare ? 'More tools at Bodega' : 'Visit bybodega.com'} <span class="arr" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="wrap" aria-labelledby="products-title">
    <h2 class="sr-only" id="products-title">Products</h2>
    <div class="filters" data-filters="shop-grid" data-filter-item=".pcard" data-expand="shop-more" role="group" aria-label="Filter by brand">
      <button class="chip chip--filter" type="button" data-filter="all" aria-pressed="true">All <span class="tab__count">{products.length}</span></button>
      {vendors.map((v) => <button class="chip chip--filter" type="button" data-filter={v.slug} aria-pressed="false">{v.label} <span class="tab__count">{v.count}</span></button>)}
    </div>
    <div id="shop-grid">
      <div data-filterable>
        <div class="pgrid" id="shop-pgrid">
          {shown.map((p) => <ProductCard product={p} sizes={sizes} />)}
        </div>
        {later.length > 0 && <template id="shop-more" data-into="shop-pgrid">{later.map((p) => <ProductCard product={p} sizes={sizes} />)}</template>}
        <p class="empty" hidden>Nothing from this brand right now.</p>
      </div>
      {later.length > 0 && (
        <div class="more-row" data-more-row="shop-more">
          <button class="btn btn--light btn--lg" type="button" data-more="shop-more" hidden>Show all {products.length} products</button>
          <noscript><a class="btn btn--light btn--lg" href="https://www.bybodega.com/" target="_blank" rel="noopener">See all {products.length} at bybodega.com ↗</a></noscript>
        </div>
      )}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="shop-book-title">
    <div class="any-band">
      <div><p class="eyebrow" style="color:var(--ink)">Due for a cut?</p><h2 class="big" id="shop-book-title">Book the<br />chair.</h2></div>
      <div class="btn-row">
        {locations.map((l, i) => <a class:list={['btn btn--lg', i > 0 && 'btn--light']} href={l.square_booking_url} target="_blank" rel="noopener">Book {l.name} <span class="arr" aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>
</Layout>
