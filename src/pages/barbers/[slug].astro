---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { localHeadshot } from '../../lib/localImages';
import Layout from '../../layouts/Layout.astro';
import BarberCard from '../../components/BarberCard.astro';
import PortfolioGrid from '../../components/PortfolioGrid.astro';
import { getBarbers, getLocationMap, getPortfolio, type Barber } from '../../lib/data';
import { barberView, parseFile, NEW_CLIENTS } from '../../lib/availability';
import bakedJson from '../../data/availability.json';
import { igUrl } from '../../lib/site';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const barbers = await getBarbers();
  return barbers.map((barber) => ({ params: { slug: barber.slug }, props: { barber } }));
}) satisfies GetStaticPaths;

interface Props { barber: Barber }
const { barber: b } = Astro.props;
const loc = (await getLocationMap())[b.location];
const work = await getPortfolio({ barber: b.slug });
const others = (await getBarbers(b.location)).filter((x) => x.slug !== b.slug).slice(0, 4);
const isPlaceholder = (f: string) => b.placeholder_fields.includes(f);
const local = localHeadshot(b.slug);
const hasPhoto = Boolean(local || b.headshot);
// Copy flagged as placeholder, or anything that reads like a developer note ("TODO client: …"), never renders publicly.
const isDevNote = (s: string) => /\b(TODO|FIXME|TBD)\b|\bclient:/i.test(s);
const bio = b.bio && !isPlaceholder('bio') && !isDevNote(b.bio) ? b.bio.trim() : '';
const description = [
  `Book ${b.name} at Skull & Thrones ${loc.name}.`,
  b.specialties.length ? `${b.specialties.slice(0, 3).join(', ')}.` : null,
  b.haircut_from != null ? `Haircuts from $${b.haircut_from}.` : null,
].filter(Boolean).join(' ');
const headshotSizes = '(min-width: 900px) 40vw, 100vw';
// Live Square availability (spec §3): chip + "Next openings" list. null = no data → both render hidden;
// src/scripts/availability.ts fills them from the live file.
const avail = barberView(parseFile(bakedJson), b.location, b.item_id, new Date());
const flag = b.accepting_new_clients ? NEW_CLIENTS.yes : NEW_CLIENTS.no;
const slotAria = (label: string) => `Book ${b.name}, ${label} (opens Square)`;
const site = Astro.site ?? new URL('https://awaisqazi.github.io');
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: b.name,
  jobTitle: b.role,
  url: new URL(b.href, site).href,
  worksFor: { '@id': new URL(url(`${loc.slug}/#salon`), site).href },
  ...(b.instagram ? { sameAs: [igUrl(b.instagram)] } : {}),
};
---
<Layout
  title={`${b.name} — ${b.role} at ${loc.name}`}
  description={description}
  current="team"
  page="barber"
  loc={b.location}
  ogType="profile"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <section class="page-hero wrap" aria-labelledby="panel-name">
    <div class="rule-row"><a class="eyebrow profile__back" href={url(`barbers/#${loc.slug}`)}>← All barbers</a><a class="eyebrow profile__back" href={loc.href}>{loc.name} · {loc.street}</a></div>
    <div class="profile">
      <div class:list={['media profile__media', !hasPhoto && 'profile__media--initials']} data-initials={b.initials}>
        {local
          ? <Image src={local} alt={`Headshot of ${b.name}`} width={900} height={1125} widths={[450, 700, 900]} sizes={headshotSizes} loading="eager" fetchpriority="high" />
          : b.headshot
            ? <Image src={b.headshot} alt={`Headshot of ${b.name}`} width={900} height={1125} widths={[450, 700, 900]} sizes={headshotSizes} loading="eager" fetchpriority="high" />
            : <span class="sr-only">Photo of {b.name} coming soon</span>}
      </div>
      <div class="profile__body">
        <p class="eyebrow">{b.role} · {loc.name}</p>
        <h1 class="panel__name" id="panel-name">{b.name}</h1>
        {b.haircut_from != null && <p class="panel__price">Haircuts from <b>${b.haircut_from}</b></p>}
        <div class="profile__flags">
          <span class="avail avail--lg" data-avail={b.item_id} data-shop={b.location} data-state={avail?.state} hidden={!avail}>
            <i class="avail__dot" aria-hidden="true"></i><span class="avail__text">{avail?.next
              ? <><span class="avail__pre">Next: </span><time datetime={avail.next.iso}>{avail.next.label}</time></>
              : avail?.text}</span>
          </span>
          <span class:list={['newclients newclients--lg', !b.accepting_new_clients && 'newclients--off']} title={flag.tip}>{flag.label}</span>
        </div>
        <section class="openings" aria-labelledby="openings-title" data-avail-list={b.item_id} data-shop={b.location} data-href={b.booking_url} data-name={b.name} hidden={!avail}>
          <h2 class="openings__title" id="openings-title">Next openings</h2>
          <ul class="openings__list">
            {avail?.soon.map((s) => (
              <li><a class="openings__slot" href={b.booking_url} target="_blank" rel="noopener" aria-label={slotAria(s.label)}><time datetime={s.iso}>{s.label}</time> <span class="arr" aria-hidden="true">↗</span></a></li>
            ))}
          </ul>
          <p class="openings__empty" hidden={avail?.state !== 'grey'}>Booked up for the next 7 days. Check Square for cancellations.</p>
          <p class="openings__note">Live from Square, refreshed every 15 minutes. Each time opens {b.first_name}'s Square page, where you confirm it.</p>
        </section>
        {b.specialties.length > 0 && <ul class="chips" aria-label="Specialties">{b.specialties.map((s) => <li class="chip">{s}</li>)}</ul>}
        {bio && <p class="panel__bio">{bio}</p>}
        {b.instagram && <a class="link" href={igUrl(b.instagram)} target="_blank" rel="noopener"><span>@{b.instagram}</span> ↗</a>}
        <div class="btn-row">
          <a class="btn btn--accent btn--lg" href={b.booking_url} target="_blank" rel="noopener"><span>Book with {b.first_name}</span> <span class="arr" aria-hidden="true">↗</span></a>
          <a class="btn btn--light btn--lg" href={work.length ? '#work' : url(`${loc.slug}/#portfolio`)}>See their work</a>
        </div>
        {!hasPhoto && <p class="note">Book opens {b.first_name}'s own Square booking page at {loc.name}. Photo coming soon.</p>}
      </div>
    </div>
  </section>

  <section class="section--tight wrap" id="work" aria-labelledby="work-title">
    <div class="sec-head">
      <span class="sec-num">Work</span>
      <div><h2 class="h2" id="work-title">Cuts by {b.first_name}.</h2><p>{work.length ? `Recent work from ${b.first_name}'s chair at ${loc.name}.` : `No photos posted yet — see the rest of the ${loc.name} floor.`}</p></div>
      <a class="link" href={url(`${loc.slug}/#portfolio`)}>All {loc.name} work <span class="arr" aria-hidden="true">→</span></a>
    </div>
    {work.length > 0 && <PortfolioGrid id="barber-work" items={work} filters={work.length > 3} emptyText={`Nothing in this category from ${b.first_name} yet.`} />}
  </section>

  {others.length > 0 && (
    <section class="section--tight wrap" aria-labelledby="more-title">
      <div class="sec-head">
        <span class="sec-num">Also at {loc.name}</span>
        <div><h2 class="h2" id="more-title">More chairs.</h2></div>
        <a class="link" href={url(`barbers/#${loc.slug}`)}>Whole team <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="grid">{others.map((o) => <BarberCard barber={o} locationName={loc.name} />)}</div>
    </section>
  )}
</Layout>
